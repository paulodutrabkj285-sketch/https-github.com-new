import { NextRequest, NextResponse } from "next/server";
import {
    buscarPedidoPorId,
    atualizarPedido,
} from "../../../lib/pedidos";
import { enviarIngressoPorEmail } from "../../../lib/email";

export const runtime = "nodejs";
export const dynamic = "force-dynamic";

export async function POST(req: NextRequest) {
    let pedidoId = "";

    try {
        // =========================================================
        // 1. RECEBE O ID DO PEDIDO
        // =========================================================
        const body = await req.json();

        pedidoId = String(body?.pedidoId || "").trim();

        if (!pedidoId) {
            return NextResponse.json(
                {
                    ok: false,
                    error: "pedidoId não informado.",
                },
                { status: 400 }
            );
        }

        console.log("REENVIO: BUSCANDO PEDIDO", {
            pedidoId,
        });

        // =========================================================
        // 2. BUSCA O PEDIDO NO FIRESTORE
        // =========================================================
        const pedido: any = await buscarPedidoPorId(pedidoId);

        if (!pedido) {
            console.error("REENVIO: PEDIDO NÃO ENCONTRADO", {
                pedidoId,
            });

            return NextResponse.json(
                {
                    ok: false,
                    error: "Pedido não encontrado.",
                },
                { status: 404 }
            );
        }

        console.log("REENVIO: PEDIDO ENCONTRADO", {
            pedidoId,
            email: pedido.email,
            codigoIngresso: pedido.codigoIngresso,
            statusPagamento: pedido.statusPagamento,
        });

        // =========================================================
        // 3. CONFERE SE EXISTE E-MAIL
        // =========================================================
        const emailCliente = String(pedido.email || "").trim();

        if (!emailCliente) {
            return NextResponse.json(
                {
                    ok: false,
                    error: "Este pedido não possui e-mail cadastrado.",
                },
                { status: 400 }
            );
        }

        // =========================================================
        // 4. CONFERE SE O PEDIDO ESTÁ PAGO
        // =========================================================
        const statusPagamento = String(
            pedido.statusPagamento || ""
        ).toLowerCase();

        if (
            statusPagamento !== "pago" &&
            statusPagamento !== "aprovado" &&
            statusPagamento !== "approved"
        ) {
            return NextResponse.json(
                {
                    ok: false,
                    error: "O pedido ainda não está com pagamento confirmado.",
                },
                { status: 400 }
            );
        }

        // =========================================================
        // 5. ENVIA NOVAMENTE O INGRESSO
        // =========================================================
        console.log("REENVIO: ENVIANDO INGRESSO", {
            pedidoId,
            email: emailCliente,
        });

        await enviarIngressoPorEmail({
            ...pedido,
            id: pedido.id || pedidoId,
        });

        // =========================================================
        // 6. REGISTRA SUCESSO NO FIRESTORE
        // =========================================================
        try {
            await atualizarPedido(pedidoId, {
                emailIngressoEnviado: true,
                emailIngressoErro: "",
                emailIngressoReenviadoEm: new Date().toISOString(),
            });
        } catch (erroFirestore) {
            console.error(
                "REENVIO: E-MAIL ENVIADO, MAS ERRO AO ATUALIZAR FIRESTORE",
                erroFirestore
            );
        }

        console.log("REENVIO: INGRESSO ENVIADO COM SUCESSO", {
            pedidoId,
            email: emailCliente,
        });

        // =========================================================
        // 7. RESPOSTA DE SUCESSO
        // =========================================================
        return NextResponse.json(
            {
                ok: true,
                pedidoId,
                email: emailCliente,
                mensagem: "Ingresso reenviado com sucesso.",
            },
            { status: 200 }
        );
    } catch (error: any) {
        // =========================================================
        // 8. TRATAMENTO DE ERRO
        // =========================================================
        const mensagemErro =
            error?.message ||
            error?.response?.data?.message ||
            String(error);

        console.error("REENVIO: ERRO AO ENVIAR INGRESSO", {
            pedidoId,
            erro: mensagemErro,
        });

        // Tenta registrar a falha no Firestore
        if (pedidoId) {
            try {
                await atualizarPedido(pedidoId, {
                    emailIngressoEnviado: false,
                    emailIngressoErro: mensagemErro,
                    emailIngressoErroEm: new Date().toISOString(),
                });
            } catch (erroFirestore) {
                console.error(
                    "REENVIO: ERRO AO REGISTRAR FALHA NO FIRESTORE",
                    erroFirestore
                );
            }
        }

        return NextResponse.json(
            {
                ok: false,
                pedidoId,
                error: mensagemErro,
            },
            { status: 500 }
        );
    }
}